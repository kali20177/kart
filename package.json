{
  "name": "kart",
  "version": "0.1.0",
  "private": true,
  "description": "嵌入式串口调试助手",
  "author": "kart",
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:terminal": "node scripts/verify-terminal.mjs",
    "verify:pty": "node scripts/verify-pty.mjs",
    "postinstall": "node scripts/check-node-pty.mjs",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit && cross-env ELECTRON=true vite build && electron-builder",
    "electron:preview": "cross-env ELECTRON=true vite build && node scripts/start-electron.mjs",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@types/node": "^20.12.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "@vueuse/core": "^11.3.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^17.1.1",
    "naive-ui": "^2.38.2",
    "pinia": "^2.1.7",
    "playwright-core": "^1.62.1",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.49.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "uplot": "^1.6.32",
    "vite": "^5.2.10",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^1.5.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.4",
    "vue-tsc": "^2.0.13",
    "vue-virtual-scroller": "2.0.0-beta.8"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "simple-git-hooks@2.13.1": true,
    "node-pty@1.1.0": true
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
