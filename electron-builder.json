{
  "appId": "com.serial-demo.app",
  "productName": "serial-demo",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "dist-electron/**",
    "package.json"
  ],
  "asarUnpack": [
    "**/*.node"
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "build/icon.icns",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
